  <version>0.0.0</version>
  <description>ROS 2 control bridge, slider GUI and diagnostics for a 6-DOF 3D-printed arm.</description>
  <maintainer email="3584046379@qq.com">newphant</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
